// Break and continue — ITEMS.md #19

// Break exits the loop early
echo "--- break in conditional loop ---"
@i = 0
loop (@i < 10) {
    if (@i == 5) {
        break
    }
    echo @i
    @i = @i + 1
}

// Continue skips to next iteration
echo "--- continue skips odds ---"
loop (@n : 0..10) {
    if (@n % 2 != 0) {
        continue
    }
    echo @n
}

// Break in iterator loop
echo "--- break in iterator loop ---"
@names = ["alice", "bob", "charlie", "dave"]
loop (@name : @names) {
    if (@name == "charlie") {
        break
    }
    echo @name
}

// Continue in iterator loop
echo "--- continue in iterator loop ---"
loop (@name : @names) {
    if (@name == "bob") {
        continue
    }
    echo @name
}

// Break in range loop
echo "--- break in range loop ---"
loop (@i : 1..=100) {
    if (@i > 5) {
        break
    }
    echo @i
}

// Nested loops: break only exits inner loop
echo "--- nested loops ---"
loop (@i : 1..=3) {
    loop (@j : 1..=3) {
        if (@j == 2) {
            break
        }
        echo "@i-@j"
    }
}
